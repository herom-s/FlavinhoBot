# Copie para `.dev.vars` (wrangler dev) e/ou `.env` (bun run set-webhook). Nunca commite os reais.
# Em produção, os 4 primeiros vão como secrets: wrangler secret put <NOME>

TELEGRAM_BOT_TOKEN=123456789:AAAA-coloque-o-token-do-botfather
TELEGRAM_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32
INTRA_CLIENT_ID=uid-do-app-na-intra
INTRA_CLIENT_SECRET=secret-do-app-na-intra

PUBLIC_BASE_URL=https://flavinhobot.sua-conta.workers.dev
# Opcional: grupos protegidos iniciais (o normal é proteger pelo Telegram com /proteger)
# PROTECTED_CHAT_IDS=-1001234567890,-1009876543210
ADMIN_CHAT_ID=-1001112223334
ADMIN_IDS=11111111,22222222   # donos do bot; outros admins entram pelo Telegram (/novo_admin)
ALLOWED_CAMPUS_IDS=20
ALLOW_STAFF=true
REVERIFY_DAYS=30
AUTO_REMOVE=false
JOIN_REQUEST_TIMEOUT_HOURS=24
GRANDFATHER_DAYS=14

# Opcionais
# INTRA_API_BASE_URL=https://api.intra.42.fr
# INTRA_MAIN_CURSUS_ID=21
# REVERIFY_MAX_PER_RUN=30
